# Firebase Configuration
# Copy this file to .env and replace the values with your actual Firebase configuration
# You can find these values in your Firebase Console → Project Settings → General → Your apps

# Only the API key is moved to environment variables for security
FIREBASE_API_KEY=your_firebase_api_key_here

# Authentication Key
# This key is required for administrative actions like adding teams, creating matches, etc.
AUTH_KEY=your_authentication_key_here 
# Optional: Groq API key for the season-facts generator (free at console.groq.com/keys)
# Without it, facts still generate — just without the AI-phrased wording.
GROQ_API_KEY=your_groq_api_key_here
